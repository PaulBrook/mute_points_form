# Copy this file to .env and fill in your values.
# Never commit .env to git.

PORT=3000

# Postgres connection string — set automatically by Heroku when you add the Postgres add-on
# For local dev, set this to your local Postgres URL, e.g.:
# DATABASE_URL=postgresql://localhost/debates
DATABASE_URL=

# A strong password for the /admin panel (username is always "admin")
ADMIN_PASSWORD=changeme

# Your email address — receives notifications for new challenges and matches
ORGANISER_EMAIL=paul.brook@gmail.com

# Public URL of this site (used in email links)
SITE_URL=https://debates.mutepoints.com

# ── SMTP email settings ──────────────────────────────────────────────────────
# Leave these blank to skip email sending (useful during local development).
# Example values below are for Gmail with an App Password.
# For Gmail: enable 2FA, then generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Mute Points <your@gmail.com>
